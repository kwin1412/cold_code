{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "CMake: 配置 (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: 构建",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "-j"
            ],
            "dependsOn": "CMake: 配置 (Debug)",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: 清理",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "运行: example",
            "type": "shell",
            "command": "./build/example/example",
            "dependsOn": "CMake: 构建",
            "problemMatcher": []
        },
        {
            "label": "格式化: clang-format",
            "type": "shell",
            "command": "clang-format -i cold_code/src/*.c cold_code/src/*.h cold_code/include/*.h example/*.c example/cold/*.c example/cold/*.h",
            "problemMatcher": []
        }
    ]
}
