{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "CMake: 配置 (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: 构建",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "-j"
            ],
            "dependsOn": "CMake: 配置 (Debug)",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: 清理",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "运行: example",
            "type": "shell",
            "command": "./build/example/example",
            "dependsOn": "CMake: 构建",
            "problemMatcher": []
        },
        {
            "label": "测试: ctest",
            "type": "shell",
            "command": "ctest --test-dir build --output-on-failure",
            "dependsOn": "CMake: 构建",
            "problemMatcher": []
        },
        {
            "label": "格式化: clang-format",
            "type": "shell",
            "command": "clang-format -i cold_code/include/*.h cold_code/include/cold_code/*.h cold_code/include/cold_code/abi/*.h cold_code/src/core/*.c cold_code/src/core/*.h cold_code/src/port/*/*.c cold_code/src/port/*/include/*.h cold_code/src/arch/x86_64/*.c cold_code/src/arch/x86_64/include/cold_code/abi/v1/*.h example/*.c example/cold/*.c example/cold/*.h tests/*.c tests/*.h tests/cold/*.c tests/cold/*.h tests/consumer/*.c tests/fixtures/*/*.c",
            "problemMatcher": []
        }
    ]
}
